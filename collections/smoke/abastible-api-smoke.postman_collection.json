    {
      "name": "02 - Obtener usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const userData = response.data;",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta contiene data\", () => {",
              "    pm.expect(response).to.have.property(\"data\");",
              "    pm.expect(userData).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"data contiene los campos obligatorios\", () => {",
              "    pm.expect(userData).to.include.all.keys(",
              "        \"userId\",",
              "        \"username\",",
              "        \"customerId\",",
              "        \"phoneNumber\",",
              "        \"email\",",
              "        \"enable\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores\", () => {",
              "    pm.expect(userData.userId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(userData.username).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(userData.customerId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(userData.phoneNumber).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"El usuario está habilitado\", () => {",
              "    pm.expect(userData.enable).to.be.true;",
              "});",
              "",
              "pm.test(\"El email está verificado\", () => {",
              "    pm.expect(userData.email).to.be.an(\"object\");",
              "    pm.expect(userData.email.verified).to.be.true;",
              "});",
              "",
              "pm.test(\"El usuario retornado corresponde al usuario autenticado\", () => {",
              "    pm.expect(userData.userId)",
              "        .to.eql(pm.environment.get(\"userId\"));",
              "});",
              "",
              "pm.test(\"El userId tiene formato UUID\", () => {",
              "    pm.expect(userData.userId).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "pm.test(\"El teléfono tiene formato chileno\", () => {",
              "    pm.expect(userData.phoneNumber).to.match(/^\\+56/);",
              "});",
              "",
              "pm.test(\"El customerId retornado por usuarios-api tiene formato de RUT\", () => {",
              "    pm.expect(userData.customerId).to.match(/^\\d{7,8}-[\\dkK]$/);",
              "});",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const userVariables = {",
              "    userId: userData.userId,",
              "",
              "    // usuarios-api expone el RUT bajo el nombre \"customerId\".",
              "    // Se guarda como \"rut\" para no sobrescribir el customerId UUID",
              "    // que se obtendrá posteriormente desde clientes-api.",
              "    rut: userData.customerId,",
              "",
              "    phoneNumber: userData.phoneNumber",
              "};",
              "",
              "if (userData.email?.value) {",
              "    userVariables.email = userData.email.value;",
              "}",
              "",
              "Object.entries(userVariables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables del usuario guardadas correctamente\", () => {",
              "    Object.entries(userVariables).forEach(([key, value]) => {",
              "        pm.expect(pm.environment.get(key)).to.eql(value);",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/seguridad/api/v1/usuarios/:id",
