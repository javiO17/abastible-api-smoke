    {
      "name": "02 - Obtener usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const data = response.data;",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta contiene data\", () => {",
              "    pm.expect(response).to.have.property(\"data\");",
              "    pm.expect(data).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"data contiene los campos obligatorios\", () => {",
              "    pm.expect(data).to.include.all.keys(",
              "        \"userId\",",
              "        \"username\",",
              "        \"customerId\",",
              "        \"phoneNumber\",",
              "        \"email\",",
              "        \"enable\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores\", () => {",
              "    pm.expect(data.userId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.username).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.customerId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.phoneNumber).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"El usuario está habilitado\", () => {",
              "    pm.expect(data.enable).to.be.true;",
              "});",
              "",
              "pm.test(\"El email está verificado\", () => {",
              "    pm.expect(data.email).to.be.an(\"object\");",
              "    pm.expect(data.email.verified).to.be.true;",
              "});",
              "",
              "pm.test(\"El usuario retornado corresponde al usuario autenticado\", () => {",
              "    pm.expect(data.userId)",
              "        .to.eql(pm.environment.get(\"userId\"));",
              "});",
              "",
              "pm.test(\"El userId tiene formato UUID\", () => {",
              "    pm.expect(data.userId).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "pm.test(\"El teléfono tiene formato chileno\", () => {",
              "    pm.expect(data.phoneNumber).to.match(/^\\+56/);",
              "});",
              "",
              "pm.test(\"El customerId retornado por usuarios-api tiene formato de RUT\", () => {",
              "    pm.expect(data.customerId).to.match(/^\\d{7,8}-[\\dkK]$/);",
              "});",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const variables = {",
              "    userId: data.userId,",
              "",
              "    // usuarios-api expone el RUT bajo el nombre \"customerId\".",
              "    // Se guarda como \"rut\" para no sobrescribir el customerId UUID",
              "    // que se obtendrá posteriormente desde clientes-api.",
              "    rut: data.customerId,",
              "",
              "    phoneNumber: data.phoneNumber",
              "};",
              "",
              "if (data.email?.value) {",
              "    variables.email = data.email.value;",
              "}",
              "",
              "Object.entries(variables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables del usuario guardadas correctamente\", () => {",
              "    Object.entries(variables).forEach(([key, value]) => {",
              "        pm.expect(pm.environment.get(key)).to.eql(value);",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
