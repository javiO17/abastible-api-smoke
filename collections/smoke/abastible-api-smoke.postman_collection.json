    {
      "name": "06 - Obtener direcciones",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const addresses = response.addresses;",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta contiene un arreglo de direcciones\", () => {",
              "    pm.expect(addresses).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "// Preferimos la favorita; si no existe, utilizamos la primera.",
              "const selectedAddress =",
              "    addresses.find(address => address.favorite === true) ?? addresses[0];",
              "",
              "pm.test(\"Se pudo seleccionar una dirección\", () => {",
              "    pm.expect(selectedAddress).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"La dirección contiene los campos obligatorios\", () => {",
              "    pm.expect(selectedAddress).to.include.all.keys(",
              "        \"addressId\",",
              "        \"address\",",
              "        \"favorite\",",
              "        \"city\",",
              "        \"state\",",
              "        \"country\",",
              "        \"salesforceId\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores\", () => {",
              "    pm.expect(selectedAddress.addressId)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "",
              "    pm.expect(selectedAddress.address)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "",
              "    pm.expect(selectedAddress.city)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "",
              "    pm.expect(selectedAddress.country)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "",
              "    pm.expect(selectedAddress.salesforceId)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"addressId tiene formato UUID\", () => {",
              "    pm.expect(selectedAddress.addressId).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "pm.test(\"El país corresponde a Chile\", () => {",
              "    pm.expect(selectedAddress.country).to.eql(\"Chile\");",
              "});",
              "",
              "pm.test(\"La ciudad tiene información\", () => {",
              "    pm.expect(selectedAddress.city)",
              "        .to.be.a(\"string\")",
              "        .and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const addressVariables = {",
              "    addressId: selectedAddress.addressId,",
              "    addressSalesforceId: selectedAddress.salesforceId,",
              "    addressAlias: selectedAddress.alias,",
              "    address: selectedAddress.address,",
              "    commune: selectedAddress.city,",
              "    city: selectedAddress.city,",
              "    state: selectedAddress.state,",
              "    country: selectedAddress.country",
              "};",
              "",
              "Object.entries(addressVariables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables de dirección guardadas correctamente\", () => {",
