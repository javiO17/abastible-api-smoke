              "    pm.expect(response.address).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(response.city).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(response.country).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"El addressId corresponde al solicitado\", () => {",
              "    pm.expect(response.addressId)",
              "        .to.eql(pm.environment.get(\"addressId\"));",
              "});",
              "",
              "pm.test(\"El país corresponde a Chile\", () => {",
              "    pm.expect(response.country).to.eql(\"Chile\");",
              "});",
              "",
              "pm.test(\"El addressId tiene formato UUID\", () => {",
              "    pm.expect(response.addressId).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "const normalizeText = (value) =>",
              "    value",
              "        .normalize(\"NFD\")",
              "        .replace(/[\\u0300-\\u036f]/g, \"\")",
              "        .toLowerCase()",
              "        .trim();",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const variables = {",
              "    alias: response.alias,",
              "    city: response.city,",
              "    state: response.state,",
              "    country: response.country,",
              "    salesforceId: response.salesforceId,",
              "    comuna: normalizeText(response.city)",
              "};",
              "",
              "Object.entries(variables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables guardadas correctamente\", () => {",
