    {
      "name": "01 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta contiene los campos obligatorios\", () => {",
              "    pm.expect(response).to.include.all.keys(",
              "        \"accessToken\",",
              "        \"refreshToken\",",
              "        \"userId\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores\", () => {",
              "    pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(response.refreshToken).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(response.userId).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"El tokenType es Bearer\", () => {",
              "    pm.expect(response.tokenType).to.eql(\"Bearer\");",
              "});",
              "",
              "pm.test(\"El accessToken tiene formato JWT\", () => {",
              "    pm.expect(response.accessToken.split(\".\")).to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"El userId tiene formato UUID\", () => {",
              "    pm.expect(response.userId).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i",
              "    );",
              "});",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const variables = {",
              "    token: response.accessToken,",
              "    refreshToken: response.refreshToken,",
              "    userId: response.userId",
              "};",
              "",
              "Object.entries(variables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables de autenticación guardadas correctamente\", () => {",
              "    Object.entries(variables).forEach(([key, value]) => {",
              "        pm.expect(pm.environment.get(key)).to.eql(value);",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
