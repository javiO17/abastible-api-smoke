              "        \"state\",",
              "        \"country\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores\", () => {",
              "    pm.expect(address.addressId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(address.address).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(address.city).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(address.country).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
