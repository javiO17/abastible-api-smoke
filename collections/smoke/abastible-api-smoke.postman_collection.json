              "});",
              "",
              "pm.test(\"El cliente posee al menos una dirección\", () => {",
              "    pm.expect(addresses.length).to.be.greaterThan(0);",
              "});",
              "",
              "const address =",
              "    addresses.find(a => a.favorite === true) || addresses[0];",
              "",
              "pm.test(\"La dirección contiene los campos obligatorios\", () => {",
              "    pm.expect(address).to.include.all.keys(",
              "        \"addressId\",",
              "        \"address\",",
