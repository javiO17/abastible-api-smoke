    {
      "name": "07 - Obtener productos disponibles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta es un arreglo\", () => {",
              "    pm.expect(response).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Existen productos disponibles\", () => {",
              "    pm.expect(response.length).to.be.greaterThan(0);",
              "});",
              "",
              "const product = response[0];",
              "",
              "pm.test(\"El producto contiene los campos obligatorios\", () => {",
              "    pm.expect(product).to.include.all.keys(",
              "        \"code\",",
              "        \"nombre\",",
              "        \"precio\",",
              "        \"kilos\",",
              "        \"tipo\",",
              "        \"descripcion\"",
              "    );",
              "});",
              "",
              "pm.test(\"Los campos principales tienen valores válidos\", () => {",
              "    pm.expect(product.code).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(product.nombre).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(product.precio).to.be.a(\"number\");",
              "    pm.expect(product.kilos).to.be.a(\"number\");",
              "    pm.expect(product.tipo).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// ==============================",
              "// Validaciones de negocio",
              "// ==============================",
              "",
              "pm.test(\"El precio del producto es mayor que cero\", () => {",
              "    pm.expect(product.precio).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"El peso del producto es mayor que cero\", () => {",
              "    pm.expect(product.kilos).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"El código del producto tiene información\", () => {",
              "    pm.expect(product.code.trim()).to.not.eql(\"\");",
              "});",
              "",
              "// ==============================",
              "// Variables para siguientes requests",
              "// ==============================",
              "",
              "const variables = {",
              "    productCode: product.code,",
              "    productName: product.nombre,",
              "    productPrice: product.precio,",
              "    productKilos: product.kilos,",
              "    productType: product.tipo",
              "};",
              "",
              "Object.entries(variables).forEach(([key, value]) => {",
              "    if (value !== undefined && value !== null) {",
              "        pm.environment.set(key, value);",
              "    }",
              "});",
              "",
              "// ==============================",
              "// Validación de persistencia",
              "// ==============================",
              "",
              "pm.test(\"Variables guardadas correctamente\", () => {",
              "    Object.entries(variables).forEach(([key, value]) => {",
              "        if (value !== undefined && value !== null) {",
              "            pm.expect(pm.environment.get(key)).to.eql(value);",
              "        }",
              "    });",
              "});"
            ],
