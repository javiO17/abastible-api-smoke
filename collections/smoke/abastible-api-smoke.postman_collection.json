        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const addresses = response.addresses;",
              "",
              "// ==============================",
              "// Validaciones de contrato",
              "// ==============================",
              "",
              "pm.test(\"La respuesta contiene un arreglo de direcciones\", () => {",
