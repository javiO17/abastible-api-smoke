              "    );",
              "});",
              "",
              "const normalizeText = (value) =>",
              "    value",
              "        .normalize(\"NFD\")",
              "        .replace(/[\\u0300-\\u036f]/g, \"\")",
              "        .toLowerCase()",
              "        .trim();",
